<?xml version="1.0" encoding="utf-8"?>
<!-- Só o nuget.org: fontes da máquina (feeds privados, pastas locais) não entram no build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
